# Example table contract — rename to <table>.yaml (dropping .disabled) and
# edit to adopt enforcement for a real table. Until a table has a contract
# file here, it is profiled in WARN-only mode per data-profile.yaml's
# advisory_rollout. See reference/config-schema.md for the full field list.

table: users

columns:
  allowed:
    - id
    - email
    - phone
    - created_at
    - updated_at
    - school_id

  expected_types:
    id: uuid
    email: text
    phone: text
    created_at: timestamptz
    updated_at: timestamptz
    school_id: uuid

  nullability:
    id: not_null
    email: not_null
    phone: nullable

  criticality:
    email: critical
    phone: critical
    school_id: critical

keys:
  primary_key: [id]
  unique:
    - [email]
  foreign_keys:
    - columns: [school_id]
      references_table: schools
      references_columns: [id]

sensitivity:
  email: { classification: pii, masking_required: true }
  phone: { classification: pii, masking_required: true }

profile:
  comparison_key: [id]
  row_count_tolerance_pct: 5.0
  duplicate_business_keys:
    - [email]
  dim_columns: []          # stable reference/dimension columns: distinct-count + value-set must not change
  null_rate:
    phone:
      benchmark_pct: 8.0
      tolerance_pct: 3.0
      block: false
  junk_patterns:
    email: ["^test@", "^n/?a$", "^unknown$"]
  anomaly:
    method: iqr
    block_columns: []      # column names where a confirmed anomaly should BLOCK, not just WARN

allowed_tolerances:
  # transactional fields expected to grow/change — do not require exact
  # equality where valid new records are expected (assignment requirement)
  row_count_growth_only: true
